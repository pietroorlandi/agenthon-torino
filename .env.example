# Copia in .env e compila. Non committare mai .env

# Google Cloud / Vertex AI (Gemini, anche per ADK) — NON AI Studio
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west4   # evitare europe-west12 e me-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.8-flash         # estrazione, riconciliazione, conflitti, Q&A, draft agent
GEMINI_MODEL_LITE=gemini-3.1-flash-lite  # triage eventi

# ElevenLabs (voce, via API)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# live = chiama Vertex (e salva in cache) · replay = usa solo la cache (fallback demo)
DEMO_MODE=live

# Osservabilità
OTEL_SERVICE_NAME=company-brain
TRACE_EXPORTER=console               # console | gcp (Cloud Trace) | otlp (Langfuse/Phoenix, opzionale)
OTEL_EXPORTER_OTLP_ENDPOINT=         # solo con TRACE_EXPORTER=otlp
LOG_PROMPTS=false                    # true solo in sviluppo: logga prompt e risposte complete
LLM_BUDGET_USD=90                    # 3 persone x $30, per l'avviso nel pannello
