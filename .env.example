# Copia in .env e compila. Non committare mai .env. Guida: docs/setup.md

# Google Cloud / Vertex AI (Gemini, anche per l'agente ADK) — NON AI Studio
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global           # endpoint Vertex: i Gemini 3.x stanno su "global" (europe-west4 dà 404). Mai europe-west12 / me-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE         # equivale al nuovo GOOGLE_GENAI_USE_ENTERPRISE: imposta solo uno dei due
GEMINI_MODEL=gemini-3.8-flash          # estrazione, Q&A, agente bozze
GEMINI_MODEL_LITE=gemini-3.1-flash-lite  # triage eventi, instradamento domande
GEMINI_THINKING_LEVEL=low              # minimal | low | medium | high | vuoto = default del modello

# live = chiama Vertex e salva in cache · replay = solo cache (src/data/llm_cache) · off = motori deterministici, nessuna chiave
# Se vuoto: live con GOOGLE_CLOUD_PROJECT impostato, altrimenti off
LLM_MODE=live

# ElevenLabs (brief audio, via API). Senza chiavi il frontend usa la voce del browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Osservabilità
OTEL_SERVICE_NAME=company-brain
TRACE_EXPORTER=none                    # none | console | gcp (Cloud Trace) | otlp (Langfuse / Phoenix)
# Solo con TRACE_EXPORTER=otlp:
# Phoenix locale:  OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# Langfuse cloud:  OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
#                  OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 di pk-lf-...:sk-lf-...>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LOG_PROMPTS=false                      # true solo in sviluppo: prompt e risposte nei log e negli span
LLM_BUDGET_USD=90                      # 3 persone x $30, per l'avviso nel pannello
